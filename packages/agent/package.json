{
  "name": "@sa-ai-assistant/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "runner": "pnpm with-env tsx ./src/runners/run.ts",
    "runner:dev": "pnpm with-env tsx ./src/runners/run.ts -- all",
    "with-env": "dotenv -e ../../.env --",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@anvia/core": "^1.1.2",
    "@anvia/langfuse": "^1.1.2",
    "@anvia/lens": "^1.1.3",
    "@anvia/openai": "^1.1.2",
    "@tavily/core": "^0.7.9",
    "exa-js": "^2.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
