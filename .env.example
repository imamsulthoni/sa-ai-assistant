# PostgreSQL connection used by apps/api Prisma
DATABASE_URL=postgresql://sa_ai_assistant_dev:sa_ai_assistant_dev_password@localhost:55432/sa_ai_assistant_dev

# Local service ports
API_PORT=8000
PLATFORM_PORT=3000

# AI provider (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Per-phase model routing (optional; falls back to OPENAI_MODEL)
# CLARIFY uses the easy model, QA/JUDGE the medium model, GENERATE the hard model.
# Rekomendasi per tingkat kesulitan (contoh id OpenRouter):
#   EASY   (CLARIFY)       -> openai/gpt-4o-mini-2024-07-18  : tercepat, klarifikasi < 10s
#   MEDIUM (JUDGE/QA)      -> deepseek/deepseek-v4-flash     : seimbang biaya & kualitas
#                             atau openai/gpt-4o-mini-2024-07-18 bila ingin lebih responsif
#   HARD   (GENERATE)      -> deepseek/deepseek-r1           : reasoning kuat, draf BRD lebih teliti
#                             (lebih lambat; ini wajar untuk penyusunan dokumen penuh)
# Hindari model verbose untuk EASY: mis. deepseek/deepseek-v4-flash-0731 pernah membuat
# satu putaran klarifikasi > 2 menit. Ukur dulu bila mengganti model.
OPENAI_EASY_MODEL=
OPENAI_MEDIUM_MODEL=
OPENAI_HARD_MODEL=

# Web search provider used by the agent tools
TAVILY_API_KEY=

# Anvia Langfuse tracing (enabled when PUBLIC + SECRET are set)
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Cloudflare R2 document storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Document processing worker
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
QDRANT_URL=http://127.0.0.1:6333
REDIS_HOST=localhost
REDIS_PORT=16379
# Batas unggah template struktur BRD (byte). Lampiran sesi/chat dibatasi 10MB
# dan impor BRD existing 20MB langsung di server + klien.
MAX_UPLOAD_BYTES=52428800
ENCRYPTION_KEY=
