generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Generated by @anvia/memory-prisma. Review before running Prisma migrations.

model AgentMemorySession {
  id        String   @id @default(cuid())
  scopeKey  String   @unique
  sessionId String
  userId    String?
  title     String?
  metadata  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AgentMemoryMessage[]
  errors   AgentMemoryError[]

  @@index([sessionId, userId])
}

model AgentMemoryMessage {
  id              String             @id @default(cuid())
  memorySessionId String
  memorySession   AgentMemorySession @relation(fields: [memorySessionId], references: [id], onDelete: Cascade)
  runId           String
  turn            Int
  position        Int
  role            String
  message         Json
  createdAt       DateTime           @default(now())

  @@unique([memorySessionId, position])
  @@index([runId])
}

model AgentMemoryError {
  id              String             @id @default(cuid())
  memorySessionId String
  memorySession   AgentMemorySession @relation(fields: [memorySessionId], references: [id], onDelete: Cascade)
  runId           String
  error           Json
  messages        Json
  createdAt       DateTime           @default(now())

  @@index([runId])
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum DocumentFileType {
  PDF
  MARKDOWN
  IMAGE_FLOWCHART
  DOCX
  OTHER
}

model Document {
  id          String         @id @default(cuid())
  userId      String
  sessionId   String?
  projectId   String?
  title       String
  fileType    DocumentFileType
  isTemplate  Boolean        @default(false)
  storageUrl  String
  objectKey   String         @unique
  fileSize    Int
  status      DocumentStatus @default(UPLOADING)
  ocrResult   String?
  summary     String?
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  pages DocumentPage[]

  @@index([sessionId, userId])
  @@index([projectId])
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  pageNumber Int
  content    String
  metadata   Json
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@index([documentId])
}
