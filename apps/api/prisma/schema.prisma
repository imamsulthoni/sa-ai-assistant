generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Generated by @anvia/memory-prisma. Review before running Prisma migrations.

model AgentMemorySession {
  id        String   @id @default(cuid())
  scopeKey  String   @unique
  sessionId String
  userId    String?
  title     String?
  metadata  Json
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AgentMemoryMessage[]
  errors   AgentMemoryError[]
  project  Project? @relation(fields: [projectId], references: [id])

  @@index([sessionId, userId])
}

model AgentMemoryMessage {
  id              String             @id @default(cuid())
  memorySessionId String
  memorySession   AgentMemorySession @relation(fields: [memorySessionId], references: [id], onDelete: Cascade)
  runId           String
  turn            Int
  position        Int
  role            String
  message         Json
  createdAt       DateTime           @default(now())

  @@unique([memorySessionId, position])
  @@index([runId])
}

model AgentMemoryError {
  id              String             @id @default(cuid())
  memorySessionId String
  memorySession   AgentMemorySession @relation(fields: [memorySessionId], references: [id], onDelete: Cascade)
  runId           String
  error           Json
  messages        Json
  createdAt       DateTime           @default(now())

  @@index([runId])
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  READY
  PENDING_CONFIRMATION
  FAILED
}

enum DocumentFileType {
  PDF
  MARKDOWN
  IMAGE_FLOWCHART
  DOCX
  OTHER
}

model Document {
  id          String         @id @default(cuid())
  userId      String
  sessionId   String?
  projectId   String?
  title       String
  fileType    DocumentFileType
  isTemplate  Boolean        @default(false)
  storageUrl  String
  objectKey   String         @unique
  fileSize    Int
  status      DocumentStatus @default(UPLOADING)
  ocrResult   String?
  summary     String?
  templateStructure Json?
  report       Json?
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  pages   DocumentPage[]
  project Project? @relation(fields: [projectId], references: [id])

  @@index([sessionId, userId])
  @@index([projectId])
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  pageNumber Int
  content    String
  metadata   Json
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  templateId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions  AgentMemorySession[]
  documents Document[]
}

model BrdDocument {
  id              String   @id @default(cuid())
  userId          String
  sessionId       String
  title           String
  currentVersion  Int      @default(1)
  contentMarkdown String
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions BrdVersion[]

  @@index([userId, sessionId])
  @@index([userId, title])
}

model BrdVersion {
  id              String   @id @default(cuid())
  brdDocumentId   String
  versionNumber   Int
  contentMarkdown String
  changeSummary   String?
  createdBy       String   @default("AI_AGENT")
  createdAt       DateTime @default(now())

  brdDocument BrdDocument @relation(fields: [brdDocumentId], references: [id], onDelete: Cascade)

  @@unique([brdDocumentId, versionNumber])
  @@index([brdDocumentId])
}

model UserSetting {
  id               String   @id @default(cuid())
  userId           String   @unique
  theme            String   @default("system")
  aiProvider       String   @default("openai")
  aiModel          String   @default("gpt-4o-mini")
  customBaseUrl    String?
  encryptedApiKey  String?
  systemPrompt     String?
  activeTemplateId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
