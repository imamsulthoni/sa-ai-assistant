{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env tsx watch src/index.ts",
    "worker": "pnpm with-env tsx watch src/worker/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "with-env": "dotenv -e ../../.env --",
    "db:migrate": "pnpm with-env prisma migrate dev",
    "db:generate": "pnpm with-env prisma generate",
    "db:deploy": "pnpm with-env prisma deploy",
    "db:studio": "pnpm with-env prisma studio"
  },
  "dependencies": {
    "@anvia/client": "^1.1.2",
    "@anvia/core": "^1.1.2",
    "@anvia/memory-prisma": "^1.1.2",
    "@anvia/mistral": "1.1.2",
    "@anvia/openai": "^1.1.2",
    "@anvia/qdrant": "1.1.2",
    "@anvia/server": "^1.1.2",
    "@anvia/transformers": "1.1.2",
    "@aws-sdk/client-s3": "^3.1128.0",
    "@hono/node-server": "^2.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sa-ai-assistant/agent": "workspace:*",
    "bullmq": "^6.3.4",
    "hono": "^4.13.7",
    "ioredis": "^5.8.2",
    "mammoth": "^1.11.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.15.5",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
